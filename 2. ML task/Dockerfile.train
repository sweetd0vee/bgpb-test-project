FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest==8.3.4 httpx==0.28.1

COPY src ./src
COPY tests ./tests
COPY pytest.ini train.py evaluate.py app.py base_logger.py ./
COPY artifacts ./artifacts

CMD ["bash", "-lc", "pytest && python train.py && python evaluate.py"]
